<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="320" />
    <scale android:fromXScale="1.03" android:toXScale="1.0"
        android:fromYScale="1.03" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="320" />
</set>